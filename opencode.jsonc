{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "pulse-image": {
        "type": "local",
        "command": ["venv/Scripts/python.exe", "mcp_server.py", "--transport", "stdio"],
        "cwd": ".",
        "codemode": false,
        "timeout": {
          "execution": 43200000
        }
      }
    }
  }
}
